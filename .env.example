NEXTAUTH_URL=https://mahmoud.jp
AUTH_SECRET=generate-a-long-random-value
GOOGLE_CLIENT_ID=google-oauth-web-client-id
GOOGLE_CLIENT_SECRET=google-oauth-web-client-secret
STUDIO_ALLOWED_EMAIL=your-google-account@example.com

# Development only: RUN-LOCAL.cmd sets this automatically to preview Studio
# without Google OAuth. It is ignored by production builds.
STUDIO_LOCAL_PREVIEW=0

# Optional read-only fine-grained GitHub token. Required for private repository
# edit history, authenticated artifact downloads, and commit-specific online
# previews in Studio. Grant only Actions: read on the selected repositories.
STUDIO_GITHUB_TOKEN=

# Existing production storage used by private Studio notes and mind-map sync.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional comma-separated origins for hosted CloudOps Coach clients. Localhost
# and Tauri origins are handled automatically; same-origin Studio needs no CORS.
CLOUDOPS_SYNC_ALLOWED_ORIGINS=https://cloudops.mahmoud.jp
